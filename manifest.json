{
  "manifest_version": 3,
  "name": "Reject All",
  "version": "0.1.0",
  "description": "Firefox-first extension that rejects or removes privacy and cookie popups as they appear.",
  "browser_specific_settings": {
    "gecko": {
      "id": "reject-all@local.extension",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Reject All",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "site-settings.js",
        "site-rules.js",
        "rules/reject-selectors.js",
        "rules/root-selectors.js",
        "rules/backdrop-selectors.js",
        "rules/privacy-keywords.js",
        "rules/reject-keywords.js",
        "rules/accept-keywords.js",
        "content-script.js"
      ],
      "css": [
        "content-styles.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
